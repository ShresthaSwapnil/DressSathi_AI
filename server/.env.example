# Local values. Production must use ENVIRONMENT=production, PostgreSQL, HTTPS,
# a unique JWT secret, and a persistent UPLOAD_DIR/object store.
ENVIRONMENT=development
JWT_SECRET_KEY=your-super-secret-key-for-development-only
DATABASE_URL=sqlite:///./dressmate.db

# Gemini is primary; Ollama is the automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
AI_TIMEOUT_SECONDS=30

# Open-Meteo defaults used when a profile has no location.
DEFAULT_LATITUDE=27.7172
DEFAULT_LONGITUDE=85.3240

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
